# Initial development requires no environment variables.
# Add names and documentation here when integrating services.
# Put real values in .env.local; never commit them.

# Supabase Dashboard > Project Settings > API (browser client uses publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: required for username login. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical origin; use localhost consistently for local email/OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kakao REST API key and client secret go ONLY in Supabase Auth > Providers > Kakao.

# Set true only after Kakao provider configuration and redirect verification.
NEXT_PUBLIC_KAKAO_AUTH_ENABLED=false

# Shared secret for the host's nightly product refresh job and the app server.
PRODUCT_REFRESH_SECRET=
# Origin used by scripts/refresh-products.mjs (defaults to the local server).
PRODUCT_REFRESH_ORIGIN=
# Optional absolute directory on a persistent volume for queued product refreshes.
# When unset, the app uses .data/product-refresh.
PRODUCT_REFRESH_DATA_DIR=
