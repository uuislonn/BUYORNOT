# Initial development requires no environment variables.
# Add names and documentation here when integrating services.
# Put real values in .env.local; never commit them.

# Supabase Dashboard > Project Settings > API (publishable key, NEVER service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin; use localhost consistently for local email/OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Kakao REST API key and client secret go ONLY in Supabase Auth > Providers > Kakao.

# Set true only after Kakao provider configuration and redirect verification.
NEXT_PUBLIC_KAKAO_AUTH_ENABLED=false
